from pathlib import Path
import sys
import pandas as pd

# ==================================================
# 1. CONNECT GOOGLE DRIVE
# ==================================================

from google.colab import drive

drive.mount("/content/drive")

# Change this path to your Google Drive folder.
DRIVE_DATA_FOLDER = (
    "/content/drive/MyDrive/"
    "Credit-Card-Fraud-Detection/data"
)

folder = Path(DRIVE_DATA_FOLDER)

DATA_PATH = folder / "creditcard.csv"

assert DATA_PATH.is_file(), (
    f"Dataset not found: {DATA_PATH}"
)

assert (folder / "fraud_experiment.py").is_file(), (
    "Missing fraud_experiment.py"
)

sys.path.insert(0, str(folder))


# ==================================================
# 2. LOAD DATASET
# ==================================================

print("Loading Credit Card Fraud Dataset...")

df = pd.read_csv(DATA_PATH)

print("\nDataset Shape:")
print(df.shape)

print("\nFirst Five Transactions:")
print(df.head())

print("\nClass Distribution:")
print(df["Class"].value_counts())

print("\nFraud Percentage:")
print(round(df["Class"].mean() * 100, 4), "%")

print("\nMissing Values:")
print(df.isnull().sum().sum())


# ==================================================
# 3. IMPORT EXPERIMENT
# ==================================================

from fraud_experiment import run


# ==================================================
# 4. EXPERIMENT SETTINGS
# ==================================================

TRIALS = 20
FOLDS = 3

OUTPUT_DIRECTORY = folder / "results"


# ==================================================
# 5. RUN MACHINE LEARNING EXPERIMENT
# ==================================================

def main():

    print("\nStarting Fraud Detection Experiment...")

    print("\nBaseline:")
    print("AdaBoost + Random Forest + KNN")

    print("\nImproved:")
    print("XGBoost + Random Forest + KNN")

    print("\nSampling: SMOTE + ENN")
    print("Optimization: Bayesian Optimization")

    comparison = run(
        data_path=str(DATA_PATH),
        output_dir=str(OUTPUT_DIRECTORY),
        trials=TRIALS,
        folds=FOLDS
    )

    print("\nFinal Model Comparison:")
    print(comparison.to_string())

    print("\nExperiment Complete!")

    print("Results saved to:")
    print(OUTPUT_DIRECTORY)


if __name__ == "__main__":
    main()
