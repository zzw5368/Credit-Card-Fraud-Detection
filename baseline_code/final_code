
"""
DS340W Credit Card Fraud Detection
Local Model Results Visualization

Compares:
1. AdaBoost + Random Forest + KNN
2. Bayesian-Optimized XGBoost + Random Forest + KNN

Displays and saves:
- Performance comparison table
- Model performance bar chart
- Confusion matrices
- ROC curves
- Precision-Recall curves
- False positive / false negative chart
- Final research summary
"""

from pathlib import Path

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.metrics import (
    roc_curve,
    precision_recall_curve,
    auc
)


# ==========================================================
# 1. LOCAL FILE PATHS
# ==========================================================

BASE_DIR = Path(__file__).resolve().parent

RESULTS_DIR = BASE_DIR / "results"

CHARTS_DIR = RESULTS_DIR / "charts"

CHARTS_DIR.mkdir(
    parents=True,
    exist_ok=True
)

MODEL_NAMES = [
    "AdaBoost_RF_KNN",
    "XGBoost_RF_KNN"
]

METRICS = [
    "Accuracy",
    "Precision",
    "Recall",
    "F1",
    "ROC_AUC",
    "PR_AUC_AP"
]


# ==========================================================
# 2. LOAD EXPERIMENT RESULTS
# ==========================================================

comparison_file = RESULTS_DIR / "model_comparison.csv"

if not comparison_file.exists():
    raise FileNotFoundError(
        f"Could not find {comparison_file}\n"
        "Run 1st_code.py first to generate model results."
    )

comparison = pd.read_csv(
    comparison_file,
    index_col="Model"
)

for name in MODEL_NAMES:
    if name not in comparison.index:
        raise ValueError(
            f"Missing model in comparison results: {name}"
        )

prediction_data = {}

for name in MODEL_NAMES:

    prediction_file = (
        RESULTS_DIR / f"{name}_predictions.csv"
    )

    if not prediction_file.exists():
        raise FileNotFoundError(
            f"Missing predictions: {prediction_file}"
        )

    prediction_data[name] = pd.read_csv(
        prediction_file
    )

print("\nResults loaded successfully.")


# ==========================================================
# 3. PERFORMANCE COMPARISON TABLE
# ==========================================================

print("\n" + "=" * 65)
print("CREDIT CARD FRAUD DETECTION")
print("ADABOOST VS XGBOOST")
print("=" * 65)

print("\nBaseline Ensemble:")
print("AdaBoost + Random Forest + KNN")

print("\nImproved Ensemble:")
print("XGBoost + Random Forest + KNN")

print("\nSampling Method: SMOTE + ENN")

print("\nMODEL PERFORMANCE TABLE\n")

print(
    comparison[METRICS]
    .round(4)
    .to_string()
)


# ==========================================================
# 4. PERFORMANCE BAR CHART
# ==========================================================

fig, ax = plt.subplots(figsize=(13, 6))

comparison[METRICS].T.plot(
    kind="bar",
    ax=ax,
    rot=0
)

ax.set_title(
    "AdaBoost vs XGBoost Ensemble Performance"
)

ax.set_ylabel("Score")
ax.set_xlabel("Evaluation Metric")

ax.set_ylim(0, 1.05)

ax.legend(title="Model")

ax.grid(
    axis="y",
    alpha=0.3
)

fig.tight_layout()

fig.savefig(
    CHARTS_DIR / "model_performance.png",
    dpi=300
)

plt.show()
plt.close(fig)


# ==========================================================
# 5. CONFUSION MATRIX COMPARISON
# ==========================================================

for name in MODEL_NAMES:

    row = comparison.loc[name]

    cm = np.array([
        [
            int(row["TN"]),
            int(row["FP"])
        ],
        [
            int(row["FN"]),
            int(row["TP"])
        ]
    ])

    fig, ax = plt.subplots(figsize=(7, 5))

    image = ax.imshow(
        cm,
        cmap="Blues"
    )

    ax.set_title(
        f"Confusion Matrix - {name}"
    )

    ax.set_xlabel("Predicted Class")
    ax.set_ylabel("Actual Class")

    ax.set_xticks([0, 1])
    ax.set_yticks([0, 1])

    ax.set_xticklabels([
        "Normal",
        "Fraud"
    ])

    ax.set_yticklabels([
        "Normal",
        "Fraud"
    ])

    for i in range(2):
        for j in range(2):

            value = cm[i, j]

            ax.text(
                j,
                i,
                str(value),
                ha="center",
                va="center"
            )

    fig.colorbar(image, ax=ax)

    fig.tight_layout()

    fig.savefig(
        CHARTS_DIR / f"{name}_confusion_matrix.png",
        dpi=300
    )

    plt.show()
    plt.close(fig)


# ==========================================================
# 6. ROC CURVE COMPARISON
# ==========================================================

fig, ax = plt.subplots(figsize=(9, 6))

for name in MODEL_NAMES:

    data = prediction_data[name]

    y_true = data["actual"]
    y_prob = data["fraud_probability"]

    fpr, tpr, _ = roc_curve(
        y_true,
        y_prob
    )

    roc_score = auc(
        fpr,
        tpr
    )

    ax.plot(
        fpr,
        tpr,
        label=f"{name}: AUC={roc_score:.4f}"
    )

ax.plot(
    [0, 1],
    [0, 1],
    linestyle="--",
    color="gray"
)

ax.set_title(
    "ROC Curve Comparison"
)

ax.set_xlabel(
    "False Positive Rate"
)

ax.set_ylabel(
    "True Positive Rate"
)

ax.legend()
ax.grid(alpha=0.3)

fig.tight_layout()

fig.savefig(
    CHARTS_DIR / "roc_comparison.png",
    dpi=300
)

plt.show()
plt.close(fig)


# ==========================================================
# 7. PRECISION-RECALL CURVE
# ==========================================================

fig, ax = plt.subplots(figsize=(9, 6))

for name in MODEL_NAMES:

    data = prediction_data[name]

    y_true = data["actual"]
    y_prob = data["fraud_probability"]

    precision, recall, _ = precision_recall_curve(
        y_true,
        y_prob
    )

    average_precision = comparison.loc[
        name,
        "PR_AUC_AP"
    ]

    ax.plot(
        recall,
        precision,
        label=f"{name}: AP={average_precision:.4f}"
    )

ax.set_title(
    "Precision-Recall Curve Comparison"
)

ax.set_xlabel("Recall")
ax.set_ylabel("Precision")

ax.legend()
ax.grid(alpha=0.3)

fig.tight_layout()

fig.savefig(
    CHARTS_DIR / "precision_recall_comparison.png",
    dpi=300
)

plt.show()
plt.close(fig)


# ==========================================================
# 8. FALSE POSITIVE / FALSE NEGATIVE COMPARISON
# ==========================================================

error_data = comparison[
    ["FP", "FN"]
]

fig, ax = plt.subplots(figsize=(10, 6))

error_data.plot(
    kind="bar",
    ax=ax,
    rot=0
)

ax.set_title(
    "False Positive and False Negative Comparison"
)

ax.set_ylabel(
    "Number of Transactions"
)

ax.set_xlabel("Model")

ax.legend([
    "False Positives",
    "False Negatives"
])

ax.grid(
    axis="y",
    alpha=0.3
)

fig.tight_layout()

fig.savefig(
    CHARTS_DIR / "error_comparison.png",
    dpi=300
)

plt.show()
plt.close(fig)


# ==========================================================
# 9. FINAL MODEL COMPARISON
# ==========================================================

baseline = comparison.loc[
    "AdaBoost_RF_KNN"
]

improved = comparison.loc[
    "XGBoost_RF_KNN"
]

print("\n" + "=" * 65)
print("FINAL RESEARCH RESULTS")
print("=" * 65)

print("\nPerformance Differences:\n")

for metric in METRICS:

    baseline_score = baseline[metric]
    improved_score = improved[metric]

    difference = (
        improved_score - baseline_score
    )

    print(
        f"{metric}: "
        f"AdaBoost={baseline_score:.4f}, "
        f"XGBoost={improved_score:.4f}, "
        f"Difference={difference:+.4f}"
    )

print("\nFalse Negative Comparison:")

print(
    "AdaBoost:",
    int(baseline["FN"])
)

print(
    "XGBoost:",
    int(improved["FN"])
)

print("\nFalse Positive Comparison:")

print(
    "AdaBoost:",
    int(baseline["FP"])
)

print(
    "XGBoost:",
    int(improved["FP"])
)


# ==========================================================
# 10. AUTOMATIC RESEARCH CONCLUSION
# ==========================================================

print("\n" + "=" * 65)
print("RESEARCH CONCLUSION")
print("=" * 65)

baseline_ap = baseline["PR_AUC_AP"]
improved_ap = improved["PR_AUC_AP"]

if improved_ap > baseline_ap:

    print(
        "The XGBoost ensemble achieved higher "
        "Average Precision than the AdaBoost ensemble "
        "on the evaluated test dataset."
    )

elif improved_ap < baseline_ap:

    print(
        "The AdaBoost ensemble achieved higher "
        "Average Precision than the XGBoost ensemble "
        "on the evaluated test dataset."
    )

else:

    print(
        "Both ensembles achieved the same "
        "Average Precision on the evaluated test dataset."
    )

if improved["FN"] < baseline["FN"]:

    print(
        "The XGBoost ensemble also produced "
        "fewer false negatives."
    )

elif improved["FN"] > baseline["FN"]:

    print(
        "The XGBoost ensemble produced "
        "more false negatives."
    )

else:

    print(
        "Both ensembles produced the same "
        "number of false negatives."
    )

print(
    "\nThese findings describe the evaluated test split. "
    "They do not establish statistical significance "
    "or final-validation performance."
)

print("\nAll comparison graphs saved to:")
print(CHARTS_DIR.resolve())

print("\nVisualization Complete!")
